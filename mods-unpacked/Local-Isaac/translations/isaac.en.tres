[gd_resource type="Translation" format=2]

[resource]
locale = "en"
messages = PoolStringArray( "CHARACTER_LOCAL_ISAAC", "Isaac", "EFFECT_LOCAL_ISAAC_HARVESTING", "Harvesting stat gains are increased to 125%", "EFFECT_LOCAL_ISAAC_STARTING_BUNNIES", "Start with 1 Dangerous Bunny", "EFFECT_LOCAL_ISAAC_STARTING_D6", "Start with a D6", "ITEM_LOCAL_ISAAC_D6", "D6", "EFFECT_LOCAL_ISAAC_D6", "Each shop reroll has a {0}% chance to make the next reroll free.", "LOCAL_ISAAC_D6_FREE_REROLLS_EARNED", "Free rerolls gained: {0}", "WEAPON_LOCAL_ISAAC_TEAR", "Tears", "EFFECT_LOCAL_ISAAC_STARTING_TEAR", "Start with a Tears weapon", "ITEM_LOCAL_ISAAC_WIRE_COAT_HANGER", "Wire Coat Hanger", "ITEM_LOCAL_ISAAC_TRUMPET", "Trumpet", "ITEM_LOCAL_ISAAC_LUCKY_RABBIT_FOOT", "Lucky Rabbit Foot", "ITEM_LOCAL_ISAAC_CUPIDS_ARROW", "Cupid's Arrow", "ITEM_LOCAL_ISAAC_BELT", "Belt", "ITEM_LOCAL_ISAAC_HOLY_WAFER", "The Wafer", "EFFECT_LOCAL_ISAAC_HOLY_WAFER", "Take {0}% less damage.", "WEAPON_CLASS_LOCAL_ISAAC_TEARS", "Tears", "WEAPON_CLASS_LOCAL_ISAAC_RANGED", "Ranged", "STAT_LOCAL_ISAAC_BOMBS", "Bombs", "CONSUMABLE_LOCAL_ISAAC_BOMB", "Bomb", "INFO_POS_STAT_LOCAL_ISAAC_BOMBS", "Bombs in stock: {0}. Automatically launches at rocks within 500 range. Each launch costs one bomb and deals 100 base explosion damage; Explosion Size increases its radius.", "INFO_NEG_STAT_LOCAL_ISAAC_BOMBS", "Bomb stock cannot be negative.", "ITEM_LOCAL_ISAAC_ROCK", "Rock", "EFFECT_LOCAL_ISAAC_ROCKS", "More rocks (+{0}).", "ITEM_LOCAL_ISAAC_MR_BOMB", "Mr. Boom", "EFFECT_LOCAL_ISAAC_MR_BOMB", "Gain {0} bombs.", "ITEM_LOCAL_ISAAC_BOMB_BOGO", "Bombs Buy One Get One", "EFFECT_LOCAL_ISAAC_BOMB_BOGO", "All dropped bomb pickups contain {0} bombs each.", "ITEM_LOCAL_ISAAC_MOMS_KNIFE", "Mom's Knife", "EFFECT_LOCAL_ISAAC_MOMS_KNIFE", "After {0} attacks across all weapons, fire one infinitely piercing knife per equipped weapon for {1} times your highest weapon damage. Triggers at most once every {2} seconds.", "EFFECT_LOCAL_ISAAC_STARTING_BOMB", "Start with {0} bomb", "ITEM_LOCAL_ISAAC_ROCK_BOTTOM", "Rock Bottom", "EFFECT_LOCAL_ISAAC_ROCK_BOTTOM", "Your stats cannot fall below their highest values since obtaining this item (except bombs).", "ITEM_LOCAL_ISAAC_LIGHT_CROWN", "Light Crown", "EFFECT_LOCAL_ISAAC_LIGHT_CROWN", "Gain +{0}% {2} at full health. After taking damage, the full-health bonus becomes +{1}% for the rest of the wave.", "ITEM_LOCAL_ISAAC_MONEY_EQUALS_POWER", "Money = Power", "EFFECT_LOCAL_ISAAC_MONEY_EQUALS_POWER", "Gain +{1}% {2} for every {0} materials you currently have.", "ITEM_LOCAL_ISAAC_SOY_MILK", "Soy Milk", "EFFECT_LOCAL_ISAAC_SOY_MILK", "+{0}% {1}. Final damage dealt is multiplied by {2}.", "ITEM_LOCAL_ISAAC_DOUBLE_VISION", "Double Vision", "EFFECT_LOCAL_ISAAC_DOUBLE_VISION", "+{0} projectile for ranged weapons.", "ITEM_LOCAL_ISAAC_BOBS_BRAIN", "Bob's Brain", "EFFECT_LOCAL_ISAAC_BOBS_BRAIN", "Spawns Bob's Brain, which explodes on contact for {0} area damage and poisons enemies for {1} damage per second for {2} seconds. Revives after {3} seconds.", "ITEM_LOCAL_ISAAC_EIGHT_INCH_NAILS", "8 Inch Nails", "EFFECT_LOCAL_ISAAC_EIGHT_INCH_NAILS", "Each ranged weapon attack has a {0}% chance to fire an infinitely piercing nail for its weapon damage. Chance increases by {3}% per 20 {1}.\n+{2} knockback for ranged weapons.", "ITEM_LOCAL_ISAAC_IPECAC", "Ipecac", "EFFECT_LOCAL_ISAAC_IPECAC", "Every {0} attacks per weapon: ranged weapons fire explosive tears and melee weapons explode on hit. The explosion deals the weapon's base damage ({1}) and poisons enemies for {2} damage per second for {3} seconds.", "ITEM_LOCAL_ISAAC_TOUGH_LOVE", "Tough Love", "EFFECT_LOCAL_ISAAC_TOUGH_LOVE", "Each weapon attack has a {0}% chance to deal {1} times damage, multiplicative with critical hits. Chance increases by {3}% per 10 {2}.", "ITEM_LOCAL_ISAAC_POLYPHEMUS", "Polyphemus", "EFFECT_LOCAL_ISAAC_POLYPHEMUS", "+{0}% {1}. Final {3} is multiplied by {2}.", "ITEM_LOCAL_ISAAC_MILK", "Milk", "ITEM_LOCAL_ISAAC_SNACK", "Snack", "ITEM_LOCAL_ISAAC_GHOST_BABY", "Ghost Baby", "EFFECT_LOCAL_ISAAC_GHOST_BABY", "Spawns Ghost Baby, which shoots infinitely piercing ghost tears dealing {0} damage.", "EFFECT_LOCAL_ISAAC_SISTER_MAGGY", "Spawns Sister Maggy, which shoots tears dealing {0} damage.", "ITEM_LOCAL_ISAAC_BROTHER_BOBBY", "Brother Bobby", "ITEM_LOCAL_ISAAC_SISTER_MAGGY", "Sister Maggy", "EFFECT_LOCAL_ISAAC_RAINBOW_BABY", "Spawns Rainbow Baby, which randomly shoots burning, explosive, poisonous, normal or ghost tears for {0}/{1}/{2}/{3}/{4} damage. Burning and poison deal {5} damage per second for {6} seconds.", "EFFECT_LOCAL_ISAAC_BROTHER_BOBBY", "Spawns Brother Bobby, which shoots tears dealing {0} damage.", "ITEM_LOCAL_ISAAC_RAINBOW_BABY", "Rainbow Baby", "ITEM_LOCAL_ISAAC_INCUBUS", "Incubus", "EFFECT_LOCAL_ISAAC_LITTLE_STEVEN", "Spawns Little Steven, which shoots tears for {0} damage, slowing enemies by {2}% and piercing {1} enemies.", "EFFECT_LOCAL_ISAAC_SUCCUBUS", "Spawns a Succubus. Gain +{1}% {2} every {0} seconds inside its aura for the rest of the wave. Leaving the aura resets the timer.", "EFFECT_LOCAL_ISAAC_INCUBUS", "Spawns an Incubus that orbits you and copies your highest-damage weapon at {0}% damage. Uses tier III Tears when you have no weapon.", "ITEM_LOCAL_ISAAC_DEMON_BABY", "Demon Baby", "EFFECT_LOCAL_ISAAC_SERAPHIM", "Spawns Seraphim, which shoots tears that pierce {1} enemies and deal {0} damage.", "ITEM_LOCAL_ISAAC_LITTLE_STEVEN", "Little Steven", "ITEM_LOCAL_ISAAC_SUCCUBUS", "Succubus", "EFFECT_LOCAL_ISAAC_DEMON_BABY", "Spawns a stationary Demon Baby, which shoots tears dealing {0} damage.", "ITEM_LOCAL_ISAAC_SERAPHIM", "Seraphim", "EFFECT_LOCAL_LILITH_STARTING_PETS", "Start with Incubus and Best Friends Forever", "EFFECT_LOCAL_ISAAC_BEST_FRIENDS_FOREVER", "Enhances pets\nDamage ×{0}, aura size ×{1}, projectile-blocking orbital speed ×{2} (additive with Guardian Angel).", "CHARACTER_LOCAL_LILITH", "Lilith", "ITEM_LOCAL_ISAAC_BEST_FRIENDS_FOREVER", "Best Friends Forever", "EFFECT_LOCAL_LILITH_CHOOSE_PET", "Choose any common pet item at the start", "ITEM_LOCAL_ISAAC_TAURUS", "Taurus", "EFFECT_LOCAL_ISAAC_TAURUS", "Gain +{0}%{3} per second during combat, up to +{1}%. At maximum, become invulnerable for {2} seconds. Once per wave.", "ITEM_LOCAL_ISAAC_ARIES", "Aries", "EFFECT_LOCAL_ISAAC_ARIES", "Gain {1} hit protection once per wave when {2} reaches {0}%.", "ITEM_LOCAL_ISAAC_CANCER", "Cancer", "EFFECT_LOCAL_ISAAC_CANCER", "After Health first falls below 50% each wave, take {0}% less damage for the rest of the wave.", "ITEM_LOCAL_ISAAC_LEO", "Leo", "EFFECT_LOCAL_ISAAC_LEO", "Destroy trees and rocks on contact.", "ITEM_LOCAL_ISAAC_VIRGO", "Virgo", "EFFECT_LOCAL_ISAAC_VIRGO", "Invulnerability duration after taking damage ×{0}.", "ITEM_LOCAL_ISAAC_LIBRA", "Libra", "EFFECT_LOCAL_ISAAC_LIBRA", "On acquisition, redistribute current values using upgrade weights of {0}%{3}, {1}%{4} and {2}{5}.", "ITEM_LOCAL_ISAAC_SCORPIO", "Scorpio", "ITEM_LOCAL_ISAAC_SAGITTARIUS", "Sagittarius", "ITEM_LOCAL_ISAAC_CAPRICORN", "Capricorn", "ITEM_LOCAL_ISAAC_PISCES", "Pisces", "ITEM_LOCAL_ISAAC_AQUARIUS", "Aquarius", "EFFECT_LOCAL_ISAAC_SCORPIO", "Weapon hits poison enemies, dealing {0} damage every {2} seconds, {1} times. Poison spreads to {3} nearby enemies.", "EFFECT_LOCAL_ISAAC_AQUARIUS", "Release a water pulse every {0} seconds, pushing nearby enemies away and slowing them by {1}% for {2} seconds.", "ITEM_LOCAL_ISAAC_GEMINI", "Gemini", "EFFECT_LOCAL_ISAAC_GEMINI", "Each wave, randomly choose an owned custom pet and create {0} temporary copies.", "ITEM_LOCAL_ISAAC_DRESSED_BOY", "Pageant Boy", "EFFECT_LOCAL_ISAAC_DRESSED_BOY", "Permanently gain {0} randomly distributed stat points.", "ITEM_LOCAL_ISAAC_RAW_MEAT", "Raw Meat", "ITEM_LOCAL_ISAAC_MOMS_EYESHADOW", "Mom's Eyeshadow", "EFFECT_LOCAL_ISAAC_MOMS_EYESHADOW", "Each weapon attack has a {0}% chance to charm enemies for {1} seconds. Every {2}{5} adds {3}% chance, up to {4}%.", "ITEM_LOCAL_ISAAC_LOST_CONTACT", "Lost Contact", "EFFECT_LOCAL_ISAAC_LOST_CONTACT", "Each weapon attack has a {0}% chance to clear enemy projectiles touched by its projectiles or melee swing. Every {2}{5} adds {3}% chance, up to {4}%.", "ITEM_LOCAL_ISAAC_MAGIC_SCAB", "Magic Scab", "ITEM_LOCAL_ISAAC_ABADDON_BABY", "Abaddon Baby", "EFFECT_LOCAL_ISAAC_ABADDON_BABY", "Spawns Abaddon Baby, which deals {0} area damage to nearby enemies every {1} seconds.", "LOCAL_ISAAC_GEMINI_CURRENT", "This wave: {0}", "LOCAL_ISAAC_GEMINI_EMPTY", "No owned custom pet to copy.", "EFFECT_LOCAL_ISAAC_MAX_HP", "Max HP {0}%", "LOCAL_ISAAC_EYESHADOW_CHARMS", "Enemies charmed: {0}", "LOCAL_ISAAC_PROJECTILES_CLEARED", "Enemy projectiles cleared: {0}", "LOCAL_ISAAC_BOMBS_GAINED", "Bombs gained: {0}", "CHARACTER_LOCAL_MAGDALENE", "Magdalene", "CHARACTER_LOCAL_CAIN", "Cain", "CHARACTER_LOCAL_BLUE_BABY", "Blue Baby", "CHARACTER_LOCAL_JUDAS", "Judas", "CHARACTER_LOCAL_KEEPER", "Keeper", "CHARACTER_LOCAL_FORGOTTEN", "The Forgotten", "WEAPON_LOCAL_ISAAC_SPIRIT_SWORD", "Spirit Sword", "WEAPON_LOCAL_ISAAC_BROKEN_PICKAXE", "Notched Pickaxe", "WEAPON_LOCAL_ISAAC_SACRIFICIAL_DAGGER", "Sacrificial Dagger", "WEAPON_LOCAL_ISAAC_BOOMERANG", "Boomerang", "WEAPON_LOCAL_ISAAC_POINTED_RIB", "Pointed Rib", "WEAPON_LOCAL_ISAAC_WOODEN_NICKEL", "Wooden Nickel", "EFFECT_LOCAL_ISAAC_NICKEL_COIN", "Kills with this weapon have a {0}% chance to gain 1 material.", "EFFECT_LOCAL_ISAAC_NICKEL_GROWTH", "Permanently gain +1% {1} for every {0} materials generated by this weapon. Each weapon has its own counter.", "EFFECT_LOCAL_ISAAC_SACRIFICE_CURSE", "Critical kills have a {0}% chance to permanently gain +1 Curse.", "EFFECT_LOCAL_ISAAC_SPIRIT_WAVE", "Each attack has a {0}% chance to fire a sword wave dealing {1} damage and piercing 1 enemy.", "LOCAL_ISAAC_CURSE_GAINED", "Curse gained: {0}", "WEAPON_CLASS_LOCAL_ISAAC_BLOODY", "Bloody", "WEAPON_CLASS_LOCAL_ISAAC_GREEDY", "Greedy", "EFFECT_LOCAL_ISAAC_SACRIFICE_HEAL", "Kills on cursed enemies have a {0}% chance to recover 1 HP.", "WEAPON_CLASS_LOCAL_ISAAC_ANGER", "Anger", "EFFECT_LOCAL_ISAAC_PICKAXE_GROWTH", "Can attack rocks. Destroying a rock has a {0}% chance to permanently gain +1% {1}. While held, bombs no longer automatically attack rocks.", "LOCAL_ISAAC_DAMAGE_GAINED", "Damage gained: {0}%", "EFFECT_LOCAL_ISAAC_PICKAXE_BOMB", "Each attack has a {0}% chance to consume 1 bomb on its first hit, dealing {1} area damage. Triggers at most once per attack.", "WEAPON_CLASS_LOCAL_ISAAC_MINING", "Mining", "WEAPON_CLASS_LOCAL_ISAAC_ZELDA", "Zelda", "EFFECT_LOCAL_ISAAC_BOOMERANG_PETRIFY", "Each shot has a {0}% chance to petrify enemies hit by its projectiles for {1} seconds.", "WEAPON_LOCAL_ISAAC_SPEAR_OF_DESTINY", "Spear of Destiny", "WEAPON_LOCAL_ISAAC_DEATHS_TOUCH", "Death's Touch", "LOCAL_ISAAC_WEAPON_CATALOG_PENDING", "Effects and stats are not yet defined.", "WEAPON_LOCAL_ISAAC_DATA_HACK", "Data Hack", "EFFECT_LOCAL_ISAAC_DATA_HACK", "Each attack triggers a random effect", "LOCAL_ISAAC_DEVIL_ROOM", "Devil Room", "LOCAL_ISAAC_ANGEL_ROOM", "Angel Room", "LOCAL_ISAAC_RETURN_SHOP", "Return to Shop", "LOCAL_ISAAC_SOLD_OUT", "Sold Out", "LOCAL_ISAAC_ROOM_FREE", "Take for free", "LOCAL_ISAAC_ROOM_CHOICE_TAKEN", "Choice already taken", "LOCAL_ISAAC_ROOM_ANGEL_HINT", "Free - choose one item", "LOCAL_ISAAC_ROOM_DEVIL_HINT", "Pay with Max HP", "LOCAL_ISAAC_ROOM_MAX_HP", "Max HP", "LOCAL_ISAAC_ROOM_CLAIMED", "Claimed", "EFFECT_LOCAL_ISAAC_RIB_SIZE", "+1% weapon size for every +1% character size.", "EFFECT_LOCAL_FORGOTTEN_STARTING_RIB", "Start with {0} Pointed Rib.", "EFFECT_LOCAL_FORGOTTEN_REVIVE", "Revive {0} time per wave. After reviving, taking damage kills you instantly.", "EFFECT_LOCAL_FORGOTTEN_BODY_SIZE", "Every 5%{0} grants +1% character size [+{2}%]; every 5{1} grants +1% character size [+{3}%]", "EFFECT_LOCAL_ISAAC_RIB_GROWTH", "Permanently gain +1%{1} when one attack directly kills {0} enemies. Triggers once per attack.", "LOCAL_ISAAC_RIB_DAMAGE_GAINED", "Permanent Damage gained by this weapon: +{0}%", "EFFECT_LOCAL_FORGOT